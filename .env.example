# Copie este arquivo para ".env" e ajuste. O ".env" NÃO vai para o Git.
# Todos os valores abaixo são exemplos fictícios. Não coloque senha de verdade neste arquivo.

# Porta HTTP do serviço
PORT=3002

# Banco de dados
#   memory = guarda tudo em memória (some ao reiniciar). É o padrão quando não há SQL_CONNECTION_STRING.
#   sql    = Azure SQL / SQL Server (exige SQL_CONNECTION_STRING).
DB_DRIVER=memory
# Formato ADO, igual ao que o portal do Azure mostra em "Cadeias de conexão":
# SQL_CONNECTION_STRING=Server=tcp:SEU-SERVIDOR.database.windows.net,1433;Database=pjbl-pedidos;User ID=SEU-USUARIO;Password=SUA-SENHA;Encrypt=true;Connection Timeout=60

# Fila dos eventos (Azure Storage Queue)
#   Sem QUEUE_CONNECTION_STRING os eventos são apenas escritos no log.
#   Com o Azurite rodando localmente, use: UseDevelopmentStorage=true
# QUEUE_CONNECTION_STRING=UseDevelopmentStorage=true
QUEUE_NAME=order-events

# Tempo (ms) até o relay tentar de novo quando a publicação de um evento falha
OUTBOX_INTERVAL_MS=3000

# Chave interna entre os serviços. Se definida, as rotas /orders e /events exigem o cabeçalho x-api-key.
# INTERNAL_API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Origens liberadas no CORS: "*" ou uma lista separada por vírgula
CORS_ORIGIN=*

# Nível de log: fatal, error, warn, info, debug, trace ou silent
LOG_LEVEL=info

# Endereço público do serviço (aparece no Swagger). Ex.: https://ms-pedidos.exemplo.azurecontainerapps.io
# PUBLIC_URL=

# Só para o teste de integração com SQL real (npm test). Use de preferência um banco separado.
# SQL_TEST_CONNECTION_STRING=Server=tcp:SEU-SERVIDOR.database.windows.net,1433;Database=pjbl-pedidos-teste;User ID=SEU-USUARIO;Password=SUA-SENHA;Encrypt=true;Connection Timeout=60
